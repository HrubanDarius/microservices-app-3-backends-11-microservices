# Parola comuna pentru contul root de MySQL
DB_ROOT_PASSWORD=root_pass

# 1. Configurare Baza de Date User
USER_DB_NAME=user_db
USER_DB_USER=user_admin
USER_DB_PASSWORD=user_pass
USER_DB_PORT=3306

# 2. Configurare Baza de Date Device
DEVICE_DB_NAME=device_db
DEVICE_DB_USER=device_admin
DEVICE_DB_PASSWORD=device_pass
DEVICE_DB_PORT=3307

# 3. Configurare Baza de Date Auth (Credential DB)
AUTH_DB_NAME=credential_db
AUTH_DB_USER=auth_admin
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_PORT=3308

# 4. Porturi aplicatii locale
USER_SERVICE_PORT=8080
DEVICE_SERVICE_PORT=8081
AUTH_SERVICE_PORT=8082